{
  "version": 1,
  "description": "Terms the faithfulness check (app.build.faithfulness) resolves to one id in either language, so a Korean line can be checked against English source text and the reverse. A place or product a summary line names must appear in its source text under the same id; a term only counts toward the line's overlap. Words under ignore contain a form but mean something else (부산물 is a by-product, not Busan) and are skipped; a form under ambiguous has a second common meaning (인도 is India and delivery), so the check notes it instead of blocking on it when the source is in the other language. Terms in one rivals group exclude each other: a line that says cancel where its source sentence says dispose names a different action. Signs map currency signs and the Hanja place abbreviations of Korean headlines (美, 中) to their entry. D97.",
  "classes": {
    "place": "strict",
    "product": "strict",
    "currency": "strict",
    "term": "soft"
  },
  "ignore": ["부산물", "인도일", "인도받", "인도하", "인도한", "인도할", "인도된", "인도조건", "인도기준", "인도시점", "인도장소", "제약조건", "제약사항", "대전환", "이사장"],
  "ambiguous": ["인도"],
  "rivals": [["term.acquire", "term.dispose", "term.cancel"], ["term.appoint", "term.resign"], ["term.merger", "term.spin_off"], ["term.rights_offering", "term.bonus_issue"], ["term.quarterly", "term.special"]],
  "signs": {"US$": "currency.usd", "C$": "currency.cad", "$": "currency.usd", "€": "currency.eur", "¥": "currency.jpy", "£": "currency.gbp", "₩": "currency.krw", "美": "place.us", "中": "place.china", "韓": "place.korea", "英": "place.uk", "日": "place.japan"},
