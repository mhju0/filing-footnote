        {"key": "use_facilities", "source_field": "fdpp_fclt", "ko": "자금조달의 목적 (시설자금)", "en": "Proceeds for facilities", "unit": "KRW", "kind": "amount"},
        {"key": "use_business_acquisition", "source_field": "fdpp_bsninh", "ko": "자금조달의 목적 (영업양수자금)", "en": "Proceeds for business acquisition", "unit": "KRW", "kind": "amount"},
        {"key": "use_operating", "source_field": "fdpp_op", "ko": "자금조달의 목적 (운영자금)", "en": "Proceeds for operations", "unit": "KRW", "kind": "amount"},
