        {"key": "dispose_purpose", "source_field": "dp_pp", "ko": "처분목적", "en": "Purpose", "unit": null, "kind": "text"},
        {"key": "decision_date", "source_field": "dp_dd", "ko": "처분결정일", "en": "Disposal decision date", "unit": null, "kind": "date"}
