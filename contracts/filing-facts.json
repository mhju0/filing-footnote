        {"key": "dispose_shares_other", "source_field": "dppln_stk_estk", "ko": "처분예정주식 (기타주식)", "en": "Planned disposal, other shares", "unit": "shares", "kind": "count"},
        {"key": "dispose_price_common", "source_field": "dpstk_prc_ostk", "ko": "처분대상주식 1주당 가격 (보통주식)", "en": "Price per share, common shares", "unit": "KRW", "kind": "amount"},
        {"key": "dispose_amount_common", "source_field": "dppln_prc_ostk", "ko": "처분예정금액 (보통주식)", "en": "Planned disposal amount, common shares", "unit": "KRW", "kind": "amount"},
