{
  "version": 2,
  "description": "Structured figures and dates extracted from DART event filings. These values are what the app shows; generated prose never carries numbers. Each endpoint is an OpenDART DS005 major-matters API; its rows join to list.json rows by rcept_no. An absent value is '-' or an empty string in the source and produces no fact. An unparseable value produces a fact row with an error and no value.",
  "kinds": {
    "amount": "exact decimal value in the stated unit: money, or units sold (대) in the documents block",
    "count": "whole number (shares)",
    "ratio": "exact decimal percentage",
    "date": "calendar date; source forms 'YYYY년 MM월 DD일' and 'YYYYMMDD'",
    "text": "whitespace-normalised source text"
  },
  "sec": {
    "description": "SEC 8-K and 8-K/A filings show only what code can verify (D64): item numbers and the event date, both from the submissions API. No figure is read from the filing text. Facts are written for every listed filing, excluded ones too, because a later 8-K/A matches its original on these two values.",
    "source": "sec:submissions",
    "fields": [
      {"key": "items", "source_field": "sec:submissions.items", "en": "Item numbers of the filing, comma-separated as filed", "unit": null, "kind": "text"},
      {"key": "report_date", "source_field": "sec:submissions.reportDate", "en": "Date of the event reported", "unit": null, "kind": "date"}
    ]
  },
