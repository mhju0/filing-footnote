      "report_names": ["유상증자결정"],
      "fields": [
        {"key": "new_shares_common", "source_field": "nstk_ostk_cnt", "ko": "신주의 종류와 수 (보통주식)", "en": "New shares, common", "unit": "shares", "kind": "count"},
        {"key": "new_shares_other", "source_field": "nstk_estk_cnt", "ko": "신주의 종류와 수 (기타주식)", "en": "New shares, other", "unit": "shares", "kind": "count"},
        {"key": "par_value", "source_field": "fv_ps", "ko": "1주당 액면가액", "en": "Par value per share", "unit": "KRW", "kind": "amount"},
        {"key": "shares_before_common", "source_field": "bfic_tisstk_ostk", "ko": "증자전 발행주식총수 (보통주식)", "en": "Shares issued before the capital increase, common", "unit": "shares", "kind": "count"},
