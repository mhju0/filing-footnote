{
  "version": 1,
  "description": "Structured figures and dates extracted from DART event filings. These values are what the app shows; generated prose never carries numbers. Each endpoint is an OpenDART DS005 major-matters API; its rows join to list.json rows by rcept_no. An absent value is '-' or an empty string in the source and produces no fact. An unparseable value produces a fact row with an error and no value.",
  "kinds": {
    "amount": "exact decimal money value in the stated unit",
    "count": "whole number (shares)",
    "ratio": "exact decimal percentage",
    "date": "calendar date; source forms 'YYYY년 MM월 DD일' and 'YYYYMMDD'",
    "text": "whitespace-normalised source text"
  },
  "sec": {
    "description": "SEC 8-K and 8-K/A filings show only what code can verify (D64): item numbers and the event date, both from the submissions API. No figure is read from the filing text. Facts are written for every listed filing, excluded ones too, because a later 8-K/A matches its original on these two values.",
    "source": "sec:submissions",
    "fields": [
      {"key": "items", "source_field": "sec:submissions.items", "en": "Item numbers of the filing, comma-separated as filed", "unit": null, "kind": "text"},
      {"key": "report_date", "source_field": "sec:submissions.reportDate", "en": "Date of the event reported", "unit": null, "kind": "date"}
    ]
  },
  "endpoints": [
    {
      "endpoint": "tsstkAqDecsn",
      "guide": "https://opendart.fss.or.kr/guide/detail.do?apiGrpCd=DS005&apiId=2020038",
      "category": "buyback",
      "report_names": ["자기주식취득결정"],
      "fields": [
        {"key": "acquire_shares_common", "source_field": "aqpln_stk_ostk", "ko": "취득예정주식 (보통주식)", "en": "Planned acquisition, common shares", "unit": "shares", "kind": "count"},
        {"key": "acquire_shares_other", "source_field": "aqpln_stk_estk", "ko": "취득예정주식 (기타주식)", "en": "Planned acquisition, other shares", "unit": "shares", "kind": "count"},
        {"key": "acquire_amount_common", "source_field": "aqpln_prc_ostk", "ko": "취득예정금액 (보통주식)", "en": "Planned acquisition amount, common shares", "unit": "KRW", "kind": "amount"},
        {"key": "acquire_amount_other", "source_field": "aqpln_prc_estk", "ko": "취득예정금액 (기타주식)", "en": "Planned acquisition amount, other shares", "unit": "KRW", "kind": "amount"},
        {"key": "acquire_period_start", "source_field": "aqexpd_bgd", "ko": "취득예상기간 시작일", "en": "Acquisition period start", "unit": null, "kind": "date"},
        {"key": "acquire_period_end", "source_field": "aqexpd_edd", "ko": "취득예상기간 종료일", "en": "Acquisition period end", "unit": null, "kind": "date"},
        {"key": "acquire_purpose", "source_field": "aq_pp", "ko": "취득목적", "en": "Purpose", "unit": null, "kind": "text"},
        {"key": "acquire_method", "source_field": "aq_mth", "ko": "취득방법", "en": "Method", "unit": null, "kind": "text"},
        {"key": "acquire_ratio_common", "source_field": "aq_wtn_div_ostk_rt", "ko": "취득 전 자기주식 보유현황 (배당가능이익 범위 내 취득, 보통주식 비율)", "en": "Treasury shares held before the acquisition (within distributable profit), common, as a share of issued shares", "unit": "percent", "kind": "ratio"},
        {"key": "decision_date", "source_field": "aq_dd", "ko": "취득결정일", "en": "Acquisition decision date", "unit": null, "kind": "date"}
      ]
